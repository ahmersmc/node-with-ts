{
  "compilerOptions": {
    "target": "es2016",
    "module": "commonjs",
    // "rootDir": "./src",
    "outDir": "./dist",
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "strict": true,
    "skipLibCheck": true /* Skip type checking all .d.ts files. */,
    "paths": {
      // "@/*": ["./*"],
      "@/utils*": ["./src/utils*"],
      "@/routes*": ["./src/routes*"],
      "@/database*": ["./database*"],
      "@/modals*": ["./src/modals*"],
      "@/schema*": ["./database/schema*"],
      "@/middlewares*": ["./src/middlewares*"]
    }
  },
  "exclude": ["node_modules"]
}
